{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "noEmit": true,
    "skipLibCheck": true,
    "paths": { "@shared/*": ["../src/shared/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "../src/shared/**/*.ts"]
}
